# Доступ Google API
GOOGLE_CREDENTIALS_FILE=service-account-key.json

# ID таблицы из URL — предпочтительный способ (docs.google.com/spreadsheets/d/<ID>/edit)
# Если не задан — таблица будет искаться по названию
GOOGLE_SPREADSHEET_ID=

# Название таблицы (используется, если не задан GOOGLE_SPREADSHEET_ID)
SPREADSHEET_NAME=module_9_lesson_2

# Название листа внутри таблицы
WORKSHEET_NAME=Лист1
